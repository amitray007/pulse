# Pulse configuration — copy to .env and fill in. Never commit .env.

# Postgres connection string (collector writes, MCP reads/operates).
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse

# Collector HTTP port.
COLLECTOR_PORT=8080

# MCP server: bearer token required to connect (keep secret; the MCP has full DB power).
MCP_AUTH_TOKEN=change-me

# MCP server HTTP port.
MCP_PORT=8090
